# ---------------------------------------------------------------- dependencies & builds
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------- secrets: never commit keys, tokens or credentials
# Put local values in .env (see .env.example); production values go in platform secrets (flyctl secrets set ...).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore
*.jks
id_rsa*
id_ed25519*
*.secret
*.secrets
secrets/
credentials*.json
service-account*.json
*-credentials.json
.npmrc.local
.netrc
# platform tokens / local state
.fly/
.fly-app
fly.local.toml
.vercel/
.netlify/
.render/
# tunnel URLs written by scripts/tunnel.sh (ephemeral, may expose a local server)
PUBLIC_URL.txt

# ---------------------------------------------------------------- runtime data (synthetic, regenerated by the seed)
data/*.db
data/*.db-*
data/uploads/
*.sqlite
*.sqlite3

# ---------------------------------------------------------------- local tooling
.claude/settings.local.json
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
*.swp
