#!/bin/sh
# Blocks commits that would add secrets. Enable once per clone:  git config core.hooksPath .githooks
# Bypass only for a verified false positive:  git commit --no-verify
fail=0

# 1) Secret-bearing files must never be staged.
bad_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)|\.(pem|key|p12|pfx|keystore|jks)$|(^|/)(credentials|service-account)[^/]*\.json$|(^|/)id_(rsa|ed25519)' | grep -v '\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "pre-commit: refusing to commit secret files:" >&2
  echo "$bad_files" | sed 's/^/  /' >&2
  fail=1
fi

# 2) Known key/token formats in added lines.
pattern='AIza[0-9A-Za-z_-]{35}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|FlyV1 [A-Za-z0-9+/=_-]{20,}|fm[12]_[A-Za-z0-9+/=_-]{20,}|AKIA[0-9A-Z]{16}|xox[abpr]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|basemaps\.cartocdn\.com[^ "]*[?&]key=[A-Za-z0-9]'
hits=""
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  [ "$f" = ".githooks/pre-commit" ] && continue
  if git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -v '^+++' | grep -qE "$pattern"; then hits="$hits $f"; fi
done
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret in staged changes (values not shown):" >&2
  for f in $hits; do echo "  $f" >&2; done
  fail=1
fi

[ "$fail" -eq 0 ] || { echo "Move the value to .env (local) or platform secrets (production)." >&2; exit 1; }
