{
  "name": "unijourney",
  "version": "0.1.0",
  "private": true,
  "description": "UniJourney - connected student-journey prototype (Farq hackathon, Student Journey track). Demonstration context: Al Yamamah University. All data synthetic.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run typecheck && vite build --config client/vite.config.ts",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "seed": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/seed/cli.ts",
    "reset": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/seed/cli.ts --reset",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "clsx": "2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "1.4.7",
    "cross-env": "10.1.0",
    "date-fns": "4.4.0",
    "express": "5.2.1",
    "fflate": "0.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.48.0",
    "motion": "12.43.0",
    "multer": "2.4.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
