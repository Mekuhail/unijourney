# UniJourney - sample environment. Everything works with no keys (demo adapters).
API_PORT=8787
# Where SQLite + uploads live (relative to repo root)
DATA_DIR=./data
# Signs the demo session cookie. Any string; change for a shared deployment.
SESSION_SECRET=change-me-demo-secret
# Demo mode enables the persona switcher, reset and demo clock. Set to false for a hardened deployment.
DEMO_MODE=true
# Fixed "now" for the demo clock (Asia/Riyadh). Leave empty to use the real clock.
DEMO_CLOCK=2026-09-27T09:00:00+03:00
# ---------------------------------------------------------------- Secrets
# Copy this file to .env (gitignored) and fill in only what you use. Never commit real values.
# In production set them as platform secrets instead, e.g.:
#   flyctl secrets set CARTO_API_KEY=... GOOGLE_MAPS_API_KEY=... SESSION_SECRET=... -a <app>
#
# CARTO Basemaps raster key (street tiles). Without it tiles show an "API key required" watermark.
# It is sent to browsers on tile URLs, so restrict it to your domains in the CARTO dashboard.
CARTO_API_KEY=
# Optional Google Maps JavaScript API key (switches the map provider). Restrict by HTTP referrer.
GOOGLE_MAPS_API_KEY=
# Optional: enable model-backed intent parsing/explanations. Leave empty for the deterministic demo assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Future authorized integrations (documented interfaces only; never enabled in the demo):
# EDUGATE_BASE_URL=
# EDUGATE_CLIENT_ID=
# SEHHATY_VERIFY_URL=
# SMTP_URL=
